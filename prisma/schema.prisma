generator client {

  provider = "prisma-client-js"

  output   = "../src/generated/prisma"

}



datasource db {

  provider = "postgresql"

  url      = env("DATABASE_URL")

}


model WhitelistedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
model Section {

  id        String   @id @default(cuid())

  key       String   @unique

  content   Json

  updatedAt DateTime @updatedAt

}

model Account {

  id                String  @id @default(cuid())

  userId            String

  type              String

  provider          String

  providerAccountId String

  refresh_token     String? @db.Text

  access_token      String? @db.Text

  expires_at        Int?

  token_type        String?

  scope             String?

  id_token          String? @db.Text

  session_state     String?



  user User @relation(fields: [userId], references: [id], onDelete: Cascade)



  @@unique([provider, providerAccountId])

}



model Session {

  id           String   @id @default(cuid())

  sessionToken String   @unique

  userId       String

  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

}



model Purchase {

  id        String   @id @default(cuid())

  userId    String

  productId String   // np. "ebook-tom-1"

  createdAt DateTime @default(now())

  /// Dostęp nadany zakupem testowym z piaskownicy (patrz Order.isSandbox).
  /// Statystyki sprzedaży filtrują po tej kolumnie — bez niej zakup testowy
  /// admina podbijał licznik "Sprzedane E-booki".
  isSandbox Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)



  @@unique([userId, productId]) // Zabezpieczenie: Jeden użytkownik może mieć tylko jedną sztukę danego produktu
  @@index([isSandbox])

}



model Order {

  id              String   @id @default(cuid())

  userId          String

  amount          Int      // w groszach

  currency        String

  status          String   // "pending", "succeeded", "failed"

  paymentIntentId String   @unique

  createdAt       DateTime @default(now())
 
  fakturowniaId     Int?     // ID w ich systemie (potrzebne do API)

  invoiceNumber     String?

  // --- DANE DO FAKTURY (SNAPSHOT) ---

  billingType       String   @default("personal") // "personal" lub "company"

  billingName       String   @default("")

  billingNip        String?  

  billingAddress    String   @default("")

  billingCity       String   @default("")

  billingPostalCode String   @default("")

  billingCountry    String   @default("PL")

 

  // --- PLIKI FAKTUR ---

  // Teraz przechowujemy dwa linki (np. do AWS S3 / Vercel Blob)

  invoicePdfUrl     String?  // Link do wersji czytelnej dla człowieka

  invoiceXmlUrl     String?  // Link do wersji strukturalnej (np. dla księgowości/KSeF)

 

  // Opcjonalnie: Numer nadany przez KSeF (przydatne w B2B)

  ksefNumber        String?

  // Znacznik wysłania powiadomienia o porzuconym koszyku (dedup dla crona)
  abandonedNotifiedAt DateTime?

  /// Zamówienie złożone w trybie piaskownicy (zakup testowy admina).
  /// Nie liczy się do statystyk sprzedaży ani nie wywołuje powiadomień o
  /// porzuconym koszyku — patrz src/app/admin/page.tsx.
  isSandbox Boolean @default(false)

  // --- RABAT (SNAPSHOT) ---
  // Trzymamy sam tekst kodu, a nie relację do DiscountCode: admin może zmienić
  // nazwę kodu w panelu, a historyczne zamówienia mają pokazywać to, co realnie
  // zostało użyte w momencie zakupu.
  discountCode   String? // np. "ALICJA10"
  discountAmount Int? // obniżka Z SAMEGO KODU w groszach
  originalAmount Int? // cena bazowa przed wszystkimi obniżkami

  // Pozostałe źródła obniżki (przecena i zniżka dla puli maili). Trzymamy nazwę
  // i kwotę osobno, żeby raport "ile kosztowała ta akcja" dało się zrobić bez
  // rozbijania jednej zbiorczej liczby.
  saleName            String?
  saleAmount          Int?
  /// ID przeceny — potrzebne, by naliczyć jej zużycie po udanej płatności
  /// nawet po zmianie nazwy. Bez relacji FK, tak jak przy discountCodeId.
  saleId              String?
  emailDiscountName   String?
  emailDiscountAmount Int?
  /// ID zniżki mailowej — analogicznie do saleId.
  emailDiscountId     String?
  /// Suma wszystkich obniżek (originalAmount - amount).
  totalDiscountAmount Int?
  // Świadomie bez relacji FK: kod może zostać usunięty z panelu, a zamówienie
  // ma zachować pełny ślad. ID służy do naliczenia zużycia właściwemu kodowi
  // nawet po zmianie jego nazwy.
  discountCodeId String?



  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Kod rabatowy. W systemie może żyć dowolna liczba kodów jednocześnie —
// każdy z własnym typem rabatu, limitem użyć i oknem czasowym.
model DiscountCode {
  id   String @id @default(cuid())
  code String @unique // zawsze UPPERCASE

  // --- WARTOŚĆ RABATU ---
  // type = "percent" -> używamy percentOff; type = "amount" -> amountOff.
  // Drugie pole jest wtedy NULL, żeby nie dało się zapisać sprzecznych danych.
  type       String @default("percent") // "percent" | "amount"
  percentOff Int? // 1-95
  amountOff  Int? // grosze

  // --- WŁĄCZNIK ---
  isActive Boolean @default(false)

  // Czy kod wolno naliczyć NA WIERZCH aktywnej przeceny / zniżki mailowej.
  // Domyślnie nie — wtedy system wybiera wariant korzystniejszy dla klientki
  // zamiast sumować obniżki.
  stackableWithSale Boolean @default(false)

  /// Utworzony lub zmieniony w piaskownicy — działa tylko dla admina,
  /// dopóki piaskownica nie zostanie wyłączona (co publikuje zmiany).
  isSandbox Boolean @default(false)

  // --- LIMIT ILOŚCIOWY ---
  // usageLimit = null oznacza brak limitu. usedCount rośnie dopiero po UDANEJ
  // płatności (webhook), żeby porzucone koszyki nie zjadały puli.
  usageLimit Int?
  usedCount  Int  @default(0)

  // --- OKNO CZASOWE ---
  // null z obu stron = kod bezterminowy.
  validFrom  DateTime?
  validUntil DateTime?

  // Dedup powiadomienia o wyczerpaniu limitu (ustawiane atomowo w webhooku).
  exhaustedNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Ustawienia cenowe — jeden wiersz na całą aplikację (id = "singleton").
// Zastępuje stałe zaszyte w kodzie, żeby cenę dało się zmienić z panelu.
model PricingSettings {
  id String @id @default("singleton")

  /// Cena, którą realnie płacą klientki (grosze).
  basePriceGrosze Int
  /// Cena przekreślona w podsumowaniu (grosze).
  regularPriceGrosze Int

  // --- PIASKOWNICA ---
  // Tryb testowy dla admina. Nie wyłącza trwających promocji — izoluje to, co
  // w nim powstanie lub zostanie zmienione (patrz pole isSandbox przy rabatach).
  sandboxEnabled Boolean @default(false)
  /// Cena bazowa podstawiana WYŁĄCZNIE adminowi w piaskownicy (grosze).
  /// null = piaskownica liczy od normalnej ceny sprzedaży.
  sandboxBasePriceGrosze Int?

  updatedAt DateTime @updatedAt
}

// Przecena — obniżka globalna, działa bez wpisywania czegokolwiek.
// W danym momencie powinna działać jedna; gdyby aktywnych było więcej,
// silnik cenowy wybiera tę korzystniejszą dla klientki.
model Sale {
  id   String @id @default(cuid())
  name String // np. "Promocja premierowa" — widoczne dla klientki w koszyku

  // type = "percent" -> percentOff; type = "fixed_price" -> fixedPrice (cena docelowa)
  type       String @default("percent") // "percent" | "fixed_price"
  percentOff Int? // 1-95
  fixedPrice Int? // grosze — ile ma kosztować w promocji

  isActive   Boolean   @default(false)
  validFrom  DateTime?
  validUntil DateTime?

  // --- LIMIT ILOŚCIOWY ---
  // Tak jak przy kodach: usageLimit = null oznacza brak limitu, a usedCount
  // rośnie dopiero po UDANEJ płatności (webhook).
  usageLimit          Int?
  usedCount           Int       @default(0)
  exhaustedNotifiedAt DateTime?

  /// Patrz DiscountCode.isSandbox.
  isSandbox Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Zniżka dla wybranej puli osób — nalicza się automatycznie, gdy zalogowany
// adres e-mail znajduje się na liście.
model EmailDiscount {
  id   String @id @default(cuid())
  name String // np. "Lista VIP"

  type       String @default("percent") // "percent" | "amount"
  percentOff Int?
  amountOff  Int? // grosze

  isActive   Boolean   @default(false)
  validFrom  DateTime?
  validUntil DateTime?

  // --- LIMIT ILOŚCIOWY ---
  // Liczy się LICZBA ZAKUPÓW, nie liczba adresów na liście: lista 50 osób
  // z limitem 10 oznacza, że zniżkę wykorzysta pierwsze 10 kupujących.
  usageLimit          Int?
  usedCount           Int       @default(0)
  exhaustedNotifiedAt DateTime?

  /// Patrz DiscountCode.isSandbox.
  isSandbox Boolean @default(false)

  members EmailDiscountMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model EmailDiscountMember {
  id         String @id @default(cuid())
  email      String // zawsze lowercase
  discountId String

  discount EmailDiscount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([discountId, email])
  @@index([email])
}

model UserProgress {

  id        String   @id @default(cuid())

  userId    String

  chapterId String   // Tutaj będziemy zapisywać "slug" pliku (np. "01-wstep")

  updatedAt DateTime @updatedAt // Data ostatniego odczytu



  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)



  @@unique([userId, chapterId]) // Użytkownik może mieć tylko jeden wpis dla danego rozdziału

}



model User {

  id            String    @id @default(cuid())

  name          String?

  email         String?   @unique

  // DODAJ TO POLE, ABY ADAPTER PRZESTAŁ KRZYCZEĆ:
 isFirstLogin  Boolean   @default(false)
  emailVerified DateTime?

  image         String?

  role          String    @default("client")

  accounts      Account[]

  sessions      Session[]

  purchases Purchase[]

  orders    Order[]

  progress UserProgress[]

  reviews   Review[]

}



model Review {
  id          String   @id @default(cuid())
  rating      Int      // 1-5
  headline    String   // Krótki nagłówek do UI (np. "Najlepszy e-book na rynku!")
  text        String   @db.Text // Pełna treść opinii (zmieniłem z 'comment' na 'text' żeby pasowało do UI)
  role        String   @default("Kursant") // Podpis zawodowy (np. "Fizjoterapeutka")
  
  isFeatured  Boolean  @default(false) // Flaga: true oznacza, że pokazujemy to na Landing Page
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}



model VerificationToken {

  identifier String

  token      String   @unique

  expires    DateTime



  @@unique([identifier, token])

} 

model News {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  published   Boolean  @default(true) // Czy widoczne dla userów
  important   Boolean  @default(false) // Czy to "ważne" powiadomienie (np. czerwony alert)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Historia powiadomień administracyjnych (sprzedaż, porzucony koszyk itd.)
// Zasilana przez src/lib/notifications.ts — zapisujemy każde wysłane powiadomienie,
// żeby admin miał audyt nawet gdy nie miał włączonych pushy na danym urządzeniu.
model AdminNotification {
  id        String   @id @default(cuid())
  type      String // "sale" | "abandoned_cart"
  title     String
  body      String   @db.Text
  url       String?
  metadata  Json? // np. { orderId, amount }
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// ===========================================================================
// LISTA OCZEKUJĄCYCH (waiting list)
// ===========================================================================
// Strona zapisów pod konkretną akcję marketingową — link z posta prowadzi na
// /zapisy/<slug>, a wpisany adres ląduje w wybranej grupie w MailerLite.
//
// Etap 1 uruchamia jedną kampanię (rekord zakładany skryptem seed), ale treść
// trzymamy już w bazie zamiast w kodzie. Dzięki temu kreator z panelu (Etap 2)
// dokłada tylko formularz nad tą tabelą — pierwsza kampania nie będzie wymagać
// przepisywania ani migracji danych.

model WaitlistPage {
  id   String @id @default(cuid())
  // Końcówka adresu: /zapisy/<slug>. Unikalna, bo to jest link wklejany w post.
  slug String @unique
  // Nazwa robocza — widoczna tylko w panelu, nie na stronie.
  name String

  // --- Treść strony ---
  headline    String
  // Fragment nagłówka do podświetlenia akcentem (jak .text-highlight na LP).
  highlight   String?
  description String  @db.Text
  ctaLabel    String  @default("Zapisz się")
  // Drobny tekst pod formularzem, np. „Bez spamu. Wypisujesz się jednym kliknięciem."
  footnote    String?

  // --- Ekran po zapisaniu ---
  successTitle   String @default("Jesteś na liście!")
  successMessage String @db.Text

  // --- Integracja z MailerLite ---
  // ID grupy w MailerLite. Puste = zbieramy wyłącznie do naszej bazy
  // (tryb awaryjny: strona działa, nawet gdy konto nie jest jeszcze podpięte).
  mailerliteGroupId String?

  // --- Zakres zbieranych danych ---
  collectName Boolean @default(false)

  // --- Wygląd ---
  // Wariant układu i motyw kolorystyczny wybierane w kreatorze. Trzymamy tu
  // KLUCZ, nie gotowe klasy CSS: gdyby w bazie siedziały klasy Tailwinda,
  // każda zmiana designu wymagałaby migracji danych, a kampanie sprzed zmiany
  // wyglądałyby inaczej niż nowe. Nieznany klucz spada na wariant domyślny.
  layoutVariant String @default("card") // "card" | "split" | "hero"
  theme         String @default("forest") // "forest" | "light" | "ink"

  // Grafika nagłówka. Adres URL, nie plik — w projekcie nie ma magazynu plików,
  // a dokładanie go pod jedno pole byłoby nieproporcjonalne. Renderujemy ją
  // zwykłym <img>, dzięki czemu działa dowolny host bez wpisu w next.config.
  heroImageUrl String?

  // Zdjęcie WYPEŁNIAJĄCE tło strony, pod kartą z treścią (inaczej niż
  // heroImageUrl, które jest osobnym blokiem nad tekstem). Nad zdjęciem
  // kładziemy nakładkę w kolorze marki — bez niej tekst leżący poza kartą
  // jest nieczytelny.
  backgroundImageUrl String?
  // Krycie nakładki w procentach (0–100). Im wyżej, tym mocniej kolor marki
  // przykrywa zdjęcie: 0 = samo zdjęcie, 100 = sam kolor.
  overlayOpacity     Int     @default(50)
  // Obrazek podglądu przy wklejeniu linku na Instagramie/Facebooku.
  // Puste = globalny obrazek strony (siteConfig.ogImage).
  ogImageUrl   String?

  // --- Okno zapisów ---
  isActive      Boolean   @default(true)
  opensAt       DateTime?
  closesAt      DateTime?
  // Twardy limit liczby zapisów. null = bez limitu.
  // Po jego osiągnięciu strona sama przestaje przyjmować adresy — to jedyny
  // sposób, żeby akcja z ograniczoną liczbą miejsc zamknęła się sama, także
  // w środku nocy, bez czyjejkolwiek interwencji.
  maxSignups    Int?
  // Co zobaczy ktoś, kto wejdzie przed startem lub po zamknięciu zapisów.
  closedMessage String?   @db.Text

  // --- Zgoda marketingowa ---
  // Treść zapisujemy przy stronie, a jej kopię przy każdym zapisie — RODO wymaga
  // wykazania, na co dokładnie zgodziła się dana osoba w chwili zapisu, a treść
  // na stronie może się później zmienić.
  consentText String @db.Text

  subscribers WaitlistSubscriber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model WaitlistSubscriber {
  id     String       @id @default(cuid())
  pageId String
  page   WaitlistPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  email String
  name  String?

  // --- Ślad zgody (RODO — zasada rozliczalności) ---
  consentText String   @db.Text
  consentAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?  @db.Text

  // --- Synchronizacja z MailerLite ---
  // Zapis do naszej bazy jest źródłem prawdy: idzie pierwszy i to on decyduje
  // o sukcesie dla użytkownika. Wysyłka do MailerLite może się nie udać
  // (awaria, limit, zły klucz) — wtedy rekord zostaje w stanie "pending"
  // i dobowy cron próbuje ponownie. Żaden kontakt nie przepada.
  syncStatus   String    @default("pending") // "pending" | "synced" | "failed" | "skipped"
  syncedAt     DateTime?
  syncError    String?   @db.Text
  syncAttempts Int       @default(0)

  createdAt DateTime @default(now())

  // Ta sama osoba nie dubluje się w obrębie jednej kampanii, ale może zapisać
  // się na kilka różnych akcji — stąd klucz złożony, nie unikalny sam e-mail.
  @@unique([pageId, email])
  @@index([syncStatus, syncAttempts])
  @@index([pageId, createdAt])
}